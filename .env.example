# =============================================================================
# Escrow no-custodio por hitos (USDC en Base) — variables de entorno
# Copiar a `.env` (raíz; lo usan Foundry y los scripts) y a `apps/web/.env.local` (Next.js, Fase 2).
#
# REGLA DE ORO: este archivo NUNCA contiene llaves privadas de wallets.
#   - El deploy firma con keystore cifrado (`cast wallet import deployer --interactive` + `--account deployer`)
#     o con hardware wallet (`--ledger`).
#   - `owner` y `arbiter` del contrato son Safes multisig: se operan firmando en la Safe, no desde el servidor.
# Las variables NEXT_PUBLIC_* se exponen al navegador: solo valores públicos.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 84532 = Base Sepolia (testnet), 8453 = Base Mainnet, 31337 = Anvil local
NEXT_PUBLIC_CHAIN_ID=84532

# -----------------------------------------------------------------------------
# Base / RPC
# -----------------------------------------------------------------------------
# RPC privados (Alchemy, QuickNode, Coinbase Developer Platform...). Los usa el backend para reconciliar
# transacciones (waitForTransactionReceipt + parseEventLogs) y Foundry para desplegar.
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<api-key>
BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<api-key>
# RPC para lecturas desde el navegador (puede ser un endpoint público o uno con allowlist de dominio).
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org

# Etherscan API v2 (una sola key para Basescan y Base Sepolia). Usada por `forge script --verify`.
ETHERSCAN_API_KEY=

# -----------------------------------------------------------------------------
# Contratos
# -----------------------------------------------------------------------------
# Dirección desplegada de MilestoneEscrow en la red de NEXT_PUBLIC_CHAIN_ID.
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=
# USDC nativo de Circle:
#   Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
#   Base Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Bloque de despliegue (punto de partida para indexar eventos).
ESCROW_DEPLOYMENT_BLOCK=0

# Parámetros del script de deploy (solo direcciones PÚBLICAS).
# owner: Safe multisig que administra fee, límites, pausa y allowlist.
ESCROW_OWNER=
# arbiter: Safe multisig / hardware wallet que resuelve disputas. NUNCA una hot wallet del servidor.
ESCROW_ARBITER=
# Treasury que recibe el fee de plataforma.
ESCROW_FEE_RECIPIENT=
# Fee en basis points (150 = 1.5%, máx. 500).
ESCROW_PLATFORM_FEE_BPS=150
# Opcional: si se omite, el script usa el USDC de Circle según la red (o despliega MockUSDC en Anvil).
# USDC_ADDRESS=

# -----------------------------------------------------------------------------
# Privy (auth delegada, embedded wallets, passkeys, smart wallets)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
# Opcional: client id por entorno (Privy dashboard > App clients).
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Secreto del servidor para verificar access tokens de Privy en Route Handlers. Nunca con NEXT_PUBLIC_.
PRIVY_APP_SECRET=
# Smart wallets (ERC-4337) + paymaster para patrocinar gas: se configuran en Privy dashboard > Smart wallets.
# URL del paymaster/bundler (p. ej. Coinbase Developer Platform) como referencia para ese panel.
PAYMASTER_URL=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Local (`pnpm db:start`): API en http://127.0.0.1:55321; las keys se ven con `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Publishable key (antes "anon key"). Sujeta a RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (antes "service_role key"). Ignora RLS: SOLO en el servidor (Route Handlers / Server Actions).
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Resend (emails transaccionales)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend (SPF/DKIM configurados).
EMAIL_FROM="Escrow <pagos@tu-dominio.com>"
EMAIL_REPLY_TO=soporte@tu-dominio.com
